PORT=3847

# Partner API (basso.vn) — dùng cho list đơn / createWebOrder
BASSO_BASE_URL=https://basso.vn
BASSO_ADMIN_BASE_URL=
BASSO_API_KEY=
BASSO_EMAIL=
BASSO_PASS=

# SSO kiểu Deki — session cookie ai.basso.vn
BASSO_AUTH_URL=https://ai.basso.vn/platform/api/auth/session
# Localhost không có cookie platform → bật DEV (tắt trên production)
NOBITA_DEV_MODE=0
NOBITA_DEV_AS=

# Telegram bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_MINUTES=5

# Google Sheets (optional) — hoặc upload credentials.json
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=

# Bright Data scrape (optional)
BRIGHTDATA_API_TOKEN=

# Playwright proxy (optional) — không hardcode
PROXY_URL=

NOBITA_BASE_URL=http://localhost:3847
