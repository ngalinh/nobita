# Bắt buộc trên wizard ai.basso.vn
PORT=3847
BASSO_BASE_URL=https://basso.vn
BASSO_API_KEY=your-basso-key-here

# SSO — nhận user (VD Vinh) từ cookie đăng nhập platform
BASSO_AUTH_URL=https://ai.basso.vn/platform/api/auth/session
NOBITA_DEV_MODE=0

# Tuỳ chọn — URL Basso có API gợi ý PTTT. "-" = tắt
BASSO_ADMIN_BASE_URL=-

# Telegram alert (sale ends 9h VN + mua gấp). Poll nền cần BASSO_EMAIL/PASS.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_SALE_ENDS_HOUR=9
TELEGRAM_POLL_MINUTES=5

# Service login — bot Telegram lấy đơn khi không có cookie user ("-" = tắt)
BASSO_EMAIL=-
BASSO_PASS=-
